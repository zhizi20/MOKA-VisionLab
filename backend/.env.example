SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRES_SECONDS=86400

# 默认已关闭 CPU 保护，batch 可自己调大。电脑卡顿时改为 1，会把 CPU 的每批张数限制到 4。
DETECTLAB_CPU_SAFE=0
# DETECTLAB_CPU_MAX_BATCH=4
# DETECTLAB_CPU_MAX_IMGSZ=640
# DETECTLAB_CPU_THREADS=4
# DETECTLAB_CPU_WORKERS=0
# DETECTLAB_ALLOW_PARALLEL_TRAIN=0
# GitHub 直连失败时会自动走这些镜像；也可换成你能用的代理。
# DETECTLAB_GH_MIRRORS=https://ghfast.top/,https://ghproxy.net/,https://gh-proxy.com/
# DETECTLAB_HF_ENDPOINT=https://hf-mirror.com
